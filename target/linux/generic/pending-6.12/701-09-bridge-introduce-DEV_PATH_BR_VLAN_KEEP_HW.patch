From: Eric Woudstra <ericwouds@gmail.com>
Subject: [PATCH] bridge: Introduce DEV_PATH_BR_VLAN_KEEP_HW

Following the path through a bridge, there are 2 situations where the action is
to keep:
1. Packets have the encap, and keep the tag at ingress and keep it at egress.
2. Packets do not have the encap, are tagged at ingress and untagged at egress.

For switchdev userports that support SWITCHDEV_OBJ_ID_PORT_VLAN in situation 2,
it is necessary to introduce DEV_PATH_BR_VLAN_KEEP_HW.

Signed-off-by: Eric Woudstra <ericwouds@gmail.com>
---
--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -862,6 +862,7 @@ struct net_device_path {
 				DEV_PATH_BR_VLAN_TAG,
 				DEV_PATH_BR_VLAN_UNTAG,
 				DEV_PATH_BR_VLAN_UNTAG_HW,
+				DEV_PATH_BR_VLAN_KEEP_HW,
 			}		vlan_mode;
 			u16		vlan_id;
 			__be16		vlan_proto;
--- a/net/bridge/br_device.c
+++ b/net/bridge/br_device.c
@@ -456,6 +456,7 @@ static int br_fill_forward_path(struct n
 	case DEV_PATH_BR_VLAN_UNTAG:
 		ctx->num_vlans--;
 		break;
+	case DEV_PATH_BR_VLAN_KEEP_HW:
 	case DEV_PATH_BR_VLAN_KEEP:
 		break;
 	default:
--- a/net/bridge/br_vlan.c
+++ b/net/bridge/br_vlan.c
@@ -1494,12 +1494,17 @@ int br_vlan_fill_forward_path_mode(struc
 	if (!(v->flags & BRIDGE_VLAN_INFO_UNTAGGED))
 		return 0;
 
-	if (path->bridge.vlan_mode == DEV_PATH_BR_VLAN_TAG)
-		path->bridge.vlan_mode = DEV_PATH_BR_VLAN_KEEP;
-	else if (v->priv_flags & BR_VLFLAG_ADDED_BY_SWITCHDEV)
-		path->bridge.vlan_mode = DEV_PATH_BR_VLAN_UNTAG_HW;
-	else
-		path->bridge.vlan_mode = DEV_PATH_BR_VLAN_UNTAG;
+	if (path->bridge.vlan_mode == DEV_PATH_BR_VLAN_TAG) {
+		if (v->priv_flags & BR_VLFLAG_ADDED_BY_SWITCHDEV)
+			path->bridge.vlan_mode = DEV_PATH_BR_VLAN_KEEP_HW;
+		else
+			path->bridge.vlan_mode = DEV_PATH_BR_VLAN_KEEP;
+	} else {
+		if (v->priv_flags & BR_VLFLAG_ADDED_BY_SWITCHDEV)
+			path->bridge.vlan_mode = DEV_PATH_BR_VLAN_UNTAG_HW;
+		else
+			path->bridge.vlan_mode = DEV_PATH_BR_VLAN_UNTAG;
+	}
 
 	return 0;
 }
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -163,6 +163,7 @@ static void nft_dev_path_info(const stru
 			case DEV_PATH_BR_VLAN_UNTAG:
 				info->num_encaps--;
 				break;
+			case DEV_PATH_BR_VLAN_KEEP_HW:
 			case DEV_PATH_BR_VLAN_KEEP:
 				break;
 			}
