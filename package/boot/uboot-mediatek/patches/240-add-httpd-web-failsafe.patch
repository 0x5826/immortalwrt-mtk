+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Minimal ARP implementation for uIP
+ */
+
+#include <linux/types.h>
+#include <linux/string.h>
+#include <asm/byteorder.h>
+#include <net/uip.h>
+#include <net/uip_arp.h>
+
+static struct uip_eth_addr ethaddr;
+static struct uip_eth_addr client_ethaddr;
+uip_ipaddr_t hostaddr;
+
+#define BUF ((struct uip_arp_hdr *)&uip_buf[0])
+#define IPBUF ((struct uip_tcpip_hdr *)&uip_buf[UIP_LLH_LEN])
+
+void uip_arp_init(void)
+{
+	memset(&client_ethaddr, 0, sizeof(client_ethaddr));
+}
+
+void uip_setethaddr(struct uip_eth_addr addr)
+{
+	ethaddr = addr;
+}
+
+void uip_set_client_ethaddr(struct uip_eth_addr addr)
+{
+	client_ethaddr = addr;
+}
+
+void uip_sethostaddr(uip_ipaddr_t addr)
+{
+	uip_ipaddr_copy(hostaddr, addr);
+}
+
+void uip_arp_arpin(void)
+{
+	if (uip_len < sizeof(struct uip_arp_hdr)) {
+		uip_len = 0;
+		return;
+	}
+
+	uip_len = 0;
+	switch (BUF->opcode) {
+	case htons(ARP_REQUEST):
+		if (uip_ipaddr_cmp(BUF->dipaddr, hostaddr)) {
+			BUF->opcode = htons(ARP_REPLY);
+			memcpy(client_ethaddr.addr, BUF->shwaddr.addr, 6);
+			memcpy(BUF->dhwaddr.addr, BUF->shwaddr.addr, 6);
+			memcpy(BUF->shwaddr.addr, ethaddr.addr, 6);
+			memcpy(BUF->ethhdr.src.addr, ethaddr.addr, 6);
+			memcpy(BUF->ethhdr.dest.addr, BUF->dhwaddr.addr, 6);
+
+			BUF->dipaddr[0] = BUF->sipaddr[0];
+			BUF->dipaddr[1] = BUF->sipaddr[1];
+			BUF->sipaddr[0] = hostaddr[0];
+			BUF->sipaddr[1] = hostaddr[1];
+
+			BUF->ethhdr.type = htons(UIP_ETHTYPE_ARP);
+			uip_len = sizeof(struct uip_arp_hdr);
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+void uip_arp_ipin(void)
+{
+}
+
+void uip_arp_out(void)
+{
+	struct uip_eth_hdr *eth = (struct uip_eth_hdr *)&uip_buf[0];
+
+	if (eth->type == htons(UIP_ETHTYPE_ARP))
+		return;
+
+	memcpy(eth->src.addr, ethaddr.addr, 6);
+	memcpy(eth->dest.addr, client_ethaddr.addr, 6);
+	eth->type = htons(UIP_ETHTYPE_IP);
+	uip_len += UIP_LLH_LEN;
+}
