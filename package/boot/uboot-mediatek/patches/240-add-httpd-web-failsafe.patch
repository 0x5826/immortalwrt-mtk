+int httpd_rx(uchar *pkt, int len)
+{
+	struct uip_eth_hdr *eth = (struct uip_eth_hdr *)pkt;
+	u16_t type = ntohs(eth->type);
+
+	if (len > UIP_BUFSIZE)
+		len = UIP_BUFSIZE;
+
+	/* Save client MAC address so replies reach the client */
+	uip_set_client_ethaddr(eth->src);
+
+	if (type == UIP_ETHTYPE_ARP) {
+		memcpy(uip_buf, pkt, len);
+		uip_len = len;
+		uip_arp_arpin();
+		if (uip_len > 0) {
+			net_send_packet(uip_buf, uip_len);
+			return 1;
+		}
+		return 0;
+	} else if (type == UIP_ETHTYPE_IP) {
+		struct uip_tcpip_hdr *ip = (struct uip_tcpip_hdr *)(pkt + UIP_LLH_LEN);
+		if (ip->proto == UIP_PROTO_TCP) {
+			memcpy(uip_buf, pkt, len);
+			uip_len = len;
+			uip_arp_ipin();
+			uip_input();
+			if (uip_len > 0) {
+				net_send_packet(uip_buf, uip_len);
+			}
+			return 1;
+		}
+	}
+	return 0;
+}
