+			in_upload = 1;
+			upload_size = 0;
+
+			char *body = strstr(data, "\r\n\r\n");
+			if (body) {
+				body += 4;
+				int chunk = uip_datalen() - (body - data);
+				if (chunk > 0) {
+					memcpy((void *)upload_addr, body, chunk);
+					upload_size = chunk;
+				}
+			}
+			return;
+		}
+
+		if (in_upload) {
+			int chunk = uip_datalen();
+			if (upload_size + chunk <= HTTPD_MAX_DATA_SIZE) {
+				memcpy((void *)(upload_addr + upload_size), data, chunk);
