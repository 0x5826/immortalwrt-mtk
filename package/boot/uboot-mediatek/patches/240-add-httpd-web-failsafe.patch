+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Minimal uIP TCP State Machine Implementation
+ */
+
+#include <linux/types.h>
+#include <linux/string.h>
+#include <asm/byteorder.h>
+#include <net/uip.h>
+#include <net/uip_arp.h>
+
+#define UIP_TCPH_LEN    20
+#define UIP_IPH_LEN     20
+#define UIP_IPTCPH_LEN  (UIP_TCPH_LEN + UIP_IPH_LEN)
+
+struct uip_tcpip_hdr {
+	u8_t  vhl, tos, len[2], ipid[2], ipoffset[2], ttl, proto;
+	u16_t ipchksum;
+	u16_t srcipaddr[2], destipaddr[2];
+	u16_t srcport, destport;
+	u8_t  seqno[4], ackno[4], tcpoffset, flags, wnd[2];
+	u16_t tcpchksum;
+	u8_t  urgp[2];
+};
+
+#define BUF ((struct uip_tcpip_hdr *)&uip_buf[UIP_LLH_LEN])
+
+#define TCP_FIN 0x01
+#define TCP_SYN 0x02
+#define TCP_RST 0x04
+#define TCP_PSH 0x08
+#define TCP_ACK 0x10
+#define TCP_URG 0x20
+
+#define UIP_PROTO_TCP  6
+
+u8_t uip_buf[UIP_BUFSIZE + 2] __attribute__((aligned(4)));
+void *uip_appdata = NULL;
+void *uip_sappdata = NULL;
+u16_t uip_len = 0;
+u16_t uip_slen = 0;
+u8_t uip_flags = 0;
+struct uip_tcp_conn *uip_conn = NULL;
+struct uip_tcp_conn uip_conns[UIP_TCP_CONNS];
+static u16_t uip_listenport = 0;
+uip_ipaddr_t hostaddr;
+static u16_t ipid = 0;
+
+void uip_sethostaddr(uip_ipaddr_t addr)
+{
+	uip_ipaddr_copy(hostaddr, addr);
+}
+
+u16_t uip_chksum(u16_t *sdata, u16_t len)
+{
+	u32_t acc = 0;
+	for (int i = 0; i < len / 2; ++i)
+		acc += ntohs(sdata[i]);
+	if (len & 1)
+		acc += ((u8_t *)sdata)[len - 1] << 8;
+	while (acc >> 16)
+		acc = (acc & 0xffff) + (acc >> 16);
+	return htons((u16_t)acc);
+}
+
+u16_t uip_ipchksum(void)
+{
+	u16_t sum = uip_chksum((u16_t *)&uip_buf[UIP_LLH_LEN], UIP_IPH_LEN);
+	return (sum == 0) ? 0xffff : sum;
+}
+
+u16_t uip_tcpchksum(void)
+{
+	u16_t len = uip_len - UIP_IPH_LEN;
+	u32_t sum = len + UIP_PROTO_TCP;
+	sum += ntohs(BUF->srcipaddr[0]);
+	sum += ntohs(BUF->srcipaddr[1]);
+	sum += ntohs(BUF->destipaddr[0]);
+	sum += ntohs(BUF->destipaddr[1]);
+
+	u16_t *p = (u16_t *)&uip_buf[UIP_LLH_LEN + UIP_IPH_LEN];
+	u16_t tlen = len;
+	while (tlen > 1) {
+		sum += ntohs(*p++);
+		tlen -= 2;
+	}
+	if (tlen == 1)
+		sum += *(u8_t *)p;
+	while (sum >> 16)
+		sum = (sum & 0xffff) + (sum >> 16);
+	return (u16_t)~sum;
+}
+
+void uip_init(void)
+{
+	int i;
+	for (i = 0; i < UIP_TCP_CONNS; ++i) {
+		uip_conns[i].tcpstateflags = UIP_CLOSED;
+		uip_conns[i].tx_ptr = NULL;
+		uip_conns[i].tx_left = 0;
+	}
+	uip_listenport = 0;
+}
+
+void uip_listen(u16_t port)
+{
+	uip_listenport = port;
+}
+
+static void uip_add_ack(u32_t seq, u32_t ack)
+{
+	BUF->seqno[0] = seq >> 24;
+	BUF->seqno[1] = seq >> 16;
+	BUF->seqno[2] = seq >> 8;
+	BUF->seqno[3] = seq;
+
+	BUF->ackno[0] = ack >> 24;
+	BUF->ackno[1] = ack >> 16;
+	BUF->ackno[2] = ack >> 8;
+	BUF->ackno[3] = ack;
+}
+
+void uip_input(void)
+{
+	u16_t len;
+
+	if (BUF->vhl != 0x45 || BUF->proto != UIP_PROTO_TCP) {
+		uip_len = 0;
+		return;
+	}
+
+	/* Match connection */
+	uip_conn = NULL;
+	for (int i = 0; i < UIP_TCP_CONNS; ++i) {
+		if (uip_conns[i].tcpstateflags != UIP_CLOSED &&
+		    BUF->destport == uip_conns[i].lport &&
+		    BUF->srcport == uip_conns[i].rport &&
+		    uip_ipaddr_cmp(BUF->srcipaddr, uip_conns[i].ripaddr)) {
+			uip_conn = &uip_conns[i];
+			break;
+		}
+	}
+
+	if (uip_conn && (BUF->flags & TCP_SYN)) {
+		uip_conn->tcpstateflags = UIP_CLOSED;
+		uip_conn->tx_ptr = NULL;
+		uip_conn->tx_left = 0;
+		uip_conn = NULL;
+	}
+
+	/* New incoming connection */
+	if (!uip_conn) {
+		if ((BUF->flags & TCP_SYN) == 0 || (BUF->flags & TCP_ACK) != 0 ||
+		    BUF->destport != htons(uip_listenport)) {
+			uip_len = 0;
+			return;
+		}
+		for (int i = 0; i < UIP_TCP_CONNS; ++i) {
+			if (uip_conns[i].tcpstateflags == UIP_CLOSED) {
+				uip_conn = &uip_conns[i];
+				break;
+			}
+		}
+		if (!uip_conn) {
+			uip_len = 0;
+			return;
+		}
+		uip_conn->lport = BUF->destport;
+		uip_conn->rport = BUF->srcport;
+		uip_ipaddr_copy(uip_conn->ripaddr, BUF->srcipaddr);
+		uip_conn->tcpstateflags = UIP_SYN_RCVD;
+		uip_conn->tx_ptr = NULL;
+		uip_conn->tx_left = 0;
+
+		u32_t r_seq = ((u32_t)BUF->seqno[0] << 24) | ((u32_t)BUF->seqno[1] << 16) |
+			      ((u32_t)BUF->seqno[2] << 8) | BUF->seqno[3];
+		u32_t l_seq = 0x12345678;
+
+		uip_add_ack(l_seq, r_seq + 1);
+		BUF->flags = TCP_SYN | TCP_ACK;
+		BUF->tcpoffset = (UIP_TCPH_LEN / 4) << 4;
+		BUF->wnd[0] = (UIP_BUFSIZE - UIP_IPTCPH_LEN - UIP_LLH_LEN) >> 8;
+		BUF->wnd[1] = (UIP_BUFSIZE - UIP_IPTCPH_LEN - UIP_LLH_LEN) & 0xff;
+
+		uip_conn->rcv_nxt[0] = (r_seq + 1) >> 24;
+		uip_conn->rcv_nxt[1] = (r_seq + 1) >> 16;
+		uip_conn->rcv_nxt[2] = (r_seq + 1) >> 8;
+		uip_conn->rcv_nxt[3] = (r_seq + 1);
+
+		uip_conn->snd_nxt[0] = (l_seq + 1) >> 24;
+		uip_conn->snd_nxt[1] = (l_seq + 1) >> 16;
+		uip_conn->snd_nxt[2] = (l_seq + 1) >> 8;
+		uip_conn->snd_nxt[3] = (l_seq + 1);
+
+		uip_slen = 0;
+		goto send_pkt;
+	}
+
+	/* Existing connection packet processing */
+	if (BUF->flags & TCP_RST) {
+		uip_conn->tcpstateflags = UIP_CLOSED;
+		uip_conn->tx_ptr = NULL;
+		uip_conn->tx_left = 0;
+		uip_flags = UIP_ABORT;
+		uip_appcall();
+		uip_len = 0;
+		return;
+	}
+
+	if (uip_conn->tcpstateflags == UIP_SYN_RCVD) {
+		if (BUF->flags & TCP_ACK) {
+			uip_conn->tcpstateflags = UIP_ESTABLISHED;
+			uip_flags = UIP_CONNECTED;
+			uip_slen = 0;
+			uip_appcall();
+		}
+	}
+
+	u32_t cur_seq = ((u32_t)uip_conn->rcv_nxt[0] << 24) | ((u32_t)uip_conn->rcv_nxt[1] << 16) |
+			((u32_t)uip_conn->rcv_nxt[2] << 8) | uip_conn->rcv_nxt[3];
+
+	len = (BUF->len[0] << 8) | BUF->len[1];
+	len -= (BUF->vhl & 0x0f) * 4 + ((BUF->tcpoffset >> 4) * 4);
+
+	uip_appdata = &uip_buf[UIP_LLH_LEN + (BUF->vhl & 0x0f) * 4 + ((BUF->tcpoffset >> 4) * 4)];
+	uip_len = len;
+	uip_slen = 0;
+	uip_flags = 0;
+
+	if (BUF->flags & TCP_ACK) {
+		uip_flags |= UIP_ACKDATA;
+	}
+
+	if (len > 0) {
+		uip_flags |= UIP_NEWDATA;
+		cur_seq += len;
+		uip_conn->rcv_nxt[0] = cur_seq >> 24;
+		uip_conn->rcv_nxt[1] = cur_seq >> 16;
+		uip_conn->rcv_nxt[2] = cur_seq >> 8;
+		uip_conn->rcv_nxt[3] = cur_seq;
+	}
+
+	if (BUF->flags & TCP_FIN) {
