+void httpd_poll(void)
+{
+	if (upload_finished) {
+		upload_finished = 0;
+
+		/* Allow brief time for the HTTP response packet to clear TX FIFO and PC to receive */
+		for (int i = 0; i < 100; i++) {
+			eth_rx();
+			mdelay(1);
+		}
+
+		char sz_buf[32];
+		snprintf(sz_buf, sizeof(sz_buf), "0x%zx", upload_size);
+		env_set("filesize", sz_buf);
+
+		int valid = 0;
+		const char *cmd = NULL;
+		int do_reboot = 1;
+
+		switch (upload_mode) {
+		case FW_TYPE_FIRMWARE:
+			printf("HTTPD: Validating OpenWrt FIT Firmware image...\n");
+			if (upload_size >= 4 && *(u32 *)upload_addr == cpu_to_be32(0xd00dfeed)) {
+				valid = 1;
+				cmd = "run web_failsafe_flash";
+			} else {
+				printf("HTTPD: ERROR! Invalid FIT image (Magic mismatch)!\n");
+			}
+			break;
+
+		case FW_TYPE_FIP:
+			printf("HTTPD: Validating BL31 + U-Boot FIP image...\n");
+			if (upload_size >= 0x20000 && upload_size <= 0x400000) {
+				u32 magic = *(u32 *)upload_addr;
+				if (magic == 0xaa640001 || magic == 0x010064aa) {
+					valid = 1;
+					cmd = "run web_failsafe_fip";
+				} else {
+					printf("HTTPD: ERROR! Invalid FIP TOC Header Magic (0x%08x)!\n", magic);
+				}
+			} else {
+				printf("HTTPD: ERROR! FIP image size out of range (%zu bytes)!\n", upload_size);
+			}
+			break;
+
+		case FW_TYPE_INITRAMFS:
+			printf("HTTPD: Validating Initramfs FIT image for RAM boot...\n");
+			if (upload_size >= 4 && *(u32 *)upload_addr == cpu_to_be32(0xd00dfeed)) {
+				valid = 1;
+				cmd = "run web_failsafe_ramboot";
+				do_reboot = 0; /* Direct boot into kernel */
+			} else {
+				printf("HTTPD: ERROR! Invalid FIT image for RAM boot!\n");
+			}
+			break;
+
+		case FW_TYPE_GPT:
+			printf("HTTPD: Validating GPT Partition Table image...\n");
+			if (upload_size >= 0x4000 && upload_size <= 0x100000) {
+				if (memcmp((void *)(upload_addr + 512), "EFI PART", 8) == 0) {
+					valid = 1;
+					cmd = "run web_failsafe_gpt";
+				} else {
+					printf("HTTPD: ERROR! Invalid GPT signature at LBA 1!\n");
+				}
+			} else {
+				printf("HTTPD: ERROR! GPT size invalid (%zu bytes)!\n", upload_size);
+			}
+			break;
+
+		case FW_TYPE_BL2:
+			printf("HTTPD: Validating ATF BL2 Preloader image...\n");
+			if (upload_size >= 0x4000 && upload_size <= 0x80000) {
+				const char *d = (const char *)upload_addr;
+				if (memcmp(d, "EMMC_BOOT", 9) == 0 ||
+				    memcmp(d, "SDMMC_BOOT", 10) == 0 ||
+				    memcmp(d, "SPINAND!", 8) == 0 ||
+				    memcmp(d, "SF_BOOT", 7) == 0 ||
+				    memcmp(d, "BRLYT", 5) == 0) {
+					valid = 1;
+					cmd = "run web_failsafe_bl2";
+				} else {
+					printf("HTTPD: ERROR! Invalid BL2 / BootROM header signature!\n");
+				}
+			} else {
+				printf("HTTPD: ERROR! BL2 size exceeds 512KB limit (%zu bytes)!\n", upload_size);
+			}
+			break;
+
+		default:
+			printf("HTTPD: Unknown upload mode %d!\n", upload_mode);
+			break;
+		}
+
+		if (!valid) {
+			printf("HTTPD: Flash aborted due to validation failure!\n");
+			return;
+		}
+
+		printf("HTTPD: Validation passed. Executing: %s ...\n", cmd);
+		int ret = run_command(cmd, 0);
+		if (ret == 0) {
+			if (do_reboot) {
+				printf("HTTPD: Action succeeded! Rebooting into new system...\n");
+				mdelay(2000);
+				do_reset(NULL, 0, 0, NULL);
+			} else {
+				printf("HTTPD: RAM boot handover complete.\n");
+			}
+		} else {
+			printf("HTTPD: Command failed or rejected! (code %d)\n", ret);
+		}
+	}
+}
