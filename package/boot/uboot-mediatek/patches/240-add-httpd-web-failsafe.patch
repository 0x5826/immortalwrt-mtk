+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Minimal uIP TCP State Machine Implementation
+ */
+
+#include <linux/types.h>
+#include <linux/string.h>
+#include <stdio.h>
+#include <asm/byteorder.h>
+#include <net/uip.h>
+#include <net/uip_arp.h>
+
+u8_t uip_buf[UIP_BUFSIZE + 2];
+void *uip_appdata;
+u16_t uip_len;
+u16_t uip_slen;
+u8_t uip_flags;
+struct uip_tcp_conn *uip_conn;
+struct uip_tcp_conn uip_conns[UIP_TCP_CONNS];
+
+extern uip_ipaddr_t hostaddr;
+
+static u16_t uip_listenport;
+static u16_t ipid;
+
+#define BUF ((struct uip_tcpip_hdr *)&uip_buf[UIP_LLH_LEN])
+
+u16_t uip_chksum(u16_t *buf, u16_t len)
+{
+	u32_t sum = 0;
+	while (len > 1) {
+		sum += *buf++;
+		len -= 2;
+	}
+	if (len == 1)
+		sum += *(u8_t *)buf;
+	while (sum >> 16)
+		sum = (sum & 0xffff) + (sum >> 16);
+	return (u16_t)~sum;
+}
+
+u16_t uip_ipchksum(void)
+{
+	return uip_chksum((u16_t *)&uip_buf[UIP_LLH_LEN], 20);
+}
+
+u16_t uip_tcpchksum(void)
+{
+	u32_t sum = 0;
+	u16_t tlen = uip_len - 20;
+
+	sum += BUF->srcipaddr[0];
+	sum += BUF->srcipaddr[1];
+	sum += BUF->destipaddr[0];
+	sum += BUF->destipaddr[1];
+	sum += htons(UIP_PROTO_TCP);
+	sum += htons(tlen);
+
+	u16_t *p = (u16_t *)&uip_buf[UIP_LLH_LEN + 20];
+	while (tlen > 1) {
+		sum += *p++;
+		tlen -= 2;
+	}
+	if (tlen == 1)
+		sum += *(u8_t *)p;
+	while (sum >> 16)
+		sum = (sum & 0xffff) + (sum >> 16);
+	return (u16_t)~sum;
+}
+
+void uip_init(void)
+{
+	int i;
+	for (i = 0; i < UIP_TCP_CONNS; ++i)
+		uip_conns[i].tcpstateflags = UIP_CLOSED;
+	uip_listenport = 0;
+}
+
+void uip_listen(u16_t port)
+{
+	uip_listenport = port;
+}
+
+static void uip_add_ack(u32_t seq, u32_t ack)
+{
+	BUF->seqno[0] = seq >> 24;
+	BUF->seqno[1] = seq >> 16;
+	BUF->seqno[2] = seq >> 8;
+	BUF->seqno[3] = seq;
+
+	BUF->ackno[0] = ack >> 24;
+	BUF->ackno[1] = ack >> 16;
+	BUF->ackno[2] = ack >> 8;
+	BUF->ackno[3] = ack;
+}
+
+void uip_input(void)
+{
+	u16_t len;
+
+	if (BUF->vhl != 0x45 || BUF->proto != UIP_PROTO_TCP) {
+		uip_len = 0;
+		return;
+	}
+
+	/* Match connection */
+	uip_conn = NULL;
+	for (int i = 0; i < UIP_TCP_CONNS; ++i) {
+		if (uip_conns[i].tcpstateflags != UIP_CLOSED &&
+		    BUF->destport == uip_conns[i].lport &&
+		    BUF->srcport == uip_conns[i].rport &&
+		    uip_ipaddr_cmp(BUF->srcipaddr, uip_conns[i].ripaddr)) {
+			uip_conn = &uip_conns[i];
+			break;
+		}
+	}
+
+	if (uip_conn && (BUF->flags & TCP_SYN)) {
+		uip_conn->tcpstateflags = UIP_CLOSED;
+		uip_conn = NULL;
+	}
+
+	/* New incoming connection */
+	if (!uip_conn) {
+		if ((BUF->flags & TCP_SYN) == 0 || (BUF->flags & TCP_ACK) != 0 ||
+		    BUF->destport != htons(uip_listenport)) {
+			uip_len = 0;
+			return;
+		}
+		for (int i = 0; i < UIP_TCP_CONNS; ++i) {
+			if (uip_conns[i].tcpstateflags == UIP_CLOSED) {
+				uip_conn = &uip_conns[i];
+				break;
+			}
+		}
+		if (!uip_conn) {
+			uip_len = 0;
+			return;
+		}
+		uip_conn->lport = BUF->destport;
+		uip_conn->rport = BUF->srcport;
+		uip_ipaddr_copy(uip_conn->ripaddr, BUF->srcipaddr);
+		uip_conn->tcpstateflags = UIP_SYN_RCVD;
+
+		u32_t r_seq = ((u32_t)BUF->seqno[0] << 24) | ((u32_t)BUF->seqno[1] << 16) |
+			      ((u32_t)BUF->seqno[2] << 8) | BUF->seqno[3];
+		u32_t l_seq = 0x12345678;
+
+		uip_add_ack(l_seq, r_seq + 1);
+		BUF->flags = TCP_SYN | TCP_ACK;
+		BUF->tcpoffset = (UIP_TCPH_LEN / 4) << 4;
+		BUF->wnd[0] = (UIP_BUFSIZE - UIP_IPTCPH_LEN - UIP_LLH_LEN) >> 8;
+		BUF->wnd[1] = (UIP_BUFSIZE - UIP_IPTCPH_LEN - UIP_LLH_LEN) & 0xff;
+
+		uip_conn->snd_nxt[0] = (l_seq + 1) >> 24;
+		uip_conn->snd_nxt[1] = (l_seq + 1) >> 16;
+		uip_conn->snd_nxt[2] = (l_seq + 1) >> 8;
+		uip_conn->snd_nxt[3] = (l_seq + 1);
+
+		uip_conn->rcv_nxt[0] = (r_seq + 1) >> 24;
+		uip_conn->rcv_nxt[1] = (r_seq + 1) >> 16;
+		uip_conn->rcv_nxt[2] = (r_seq + 1) >> 8;
+		uip_conn->rcv_nxt[3] = (r_seq + 1);
+
+		goto send_pkt;
+	}
+
+	/* Established state */
+	u32_t cur_seq = ((u32_t)BUF->seqno[0] << 24) | ((u32_t)BUF->seqno[1] << 16) |
+			((u32_t)BUF->seqno[2] << 8) | BUF->seqno[3];
+
+	if (BUF->flags & TCP_RST) {
+		uip_conn->tcpstateflags = UIP_CLOSED;
+		uip_len = 0;
+		return;
+	}
+
+	if (uip_conn->tcpstateflags == UIP_SYN_RCVD) {
+		if (BUF->flags & TCP_ACK) {
+			uip_conn->tcpstateflags = UIP_ESTABLISHED;
+		}
+	}
+
+	len = (BUF->len[0] << 8) | BUF->len[1];
+	len -= (BUF->vhl & 0x0f) * 4 + ((BUF->tcpoffset >> 4) * 4);
+
+	uip_appdata = &uip_buf[UIP_LLH_LEN + (BUF->vhl & 0x0f) * 4 + ((BUF->tcpoffset >> 4) * 4)];
+	uip_len = len;
+	uip_slen = 0;
+	uip_flags = 0;
+
+	if (BUF->flags & TCP_ACK) {
+		uip_flags |= UIP_ACKDATA;
+	}
+
+	if (len > 0) {
+		uip_flags |= UIP_NEWDATA;
+		cur_seq += len;
+		uip_conn->rcv_nxt[0] = cur_seq >> 24;
+		uip_conn->rcv_nxt[1] = cur_seq >> 16;
+		uip_conn->rcv_nxt[2] = cur_seq >> 8;
+		uip_conn->rcv_nxt[3] = cur_seq;
+	}
+
+	if (BUF->flags & TCP_FIN) {
+		uip_flags |= UIP_CLOSE;
+		cur_seq += 1;
+		uip_conn->rcv_nxt[0] = cur_seq >> 24;
+		uip_conn->rcv_nxt[1] = cur_seq >> 16;
+		uip_conn->rcv_nxt[2] = cur_seq >> 8;
+		uip_conn->rcv_nxt[3] = cur_seq;
+		uip_conn->tcpstateflags = UIP_CLOSED;
+	}
+
+	uip_appcall();
+
+	if (uip_slen > 0 || (uip_flags & UIP_NEWDATA) || (BUF->flags & TCP_FIN)) {
+		u32_t snd = ((u32_t)uip_conn->snd_nxt[0] << 24) | ((u32_t)uip_conn->snd_nxt[1] << 16) |
+			    ((u32_t)uip_conn->snd_nxt[2] << 8) | uip_conn->snd_nxt[3];
+		u32_t rcv = ((u32_t)uip_conn->rcv_nxt[0] << 24) | ((u32_t)uip_conn->rcv_nxt[1] << 16) |
+			    ((u32_t)uip_conn->rcv_nxt[2] << 8) | uip_conn->rcv_nxt[3];
+
+		uip_add_ack(snd, rcv);
+		BUF->flags = TCP_ACK;
+		if (uip_slen > 0) {
+			BUF->flags |= TCP_PSH;
+			snd += uip_slen;
+		}
+		if (uip_flags & UIP_CLOSE) {
+			BUF->flags |= TCP_FIN;
+			snd += 1;
+			uip_conn->tcpstateflags = UIP_CLOSED;
+		}
+		uip_conn->snd_nxt[0] = snd >> 24;
+		uip_conn->snd_nxt[1] = snd >> 16;
+		uip_conn->snd_nxt[2] = snd >> 8;
+		uip_conn->snd_nxt[3] = snd;
+		goto send_pkt;
+	}
+
+	uip_len = 0;
+	return;
+
+send_pkt:
+	if (uip_slen > 0 && uip_appdata && uip_appdata != &uip_buf[UIP_LLH_LEN + UIP_IPTCPH_LEN]) {
+		memcpy(&uip_buf[UIP_LLH_LEN + UIP_IPTCPH_LEN], uip_appdata, uip_slen);
+	}
+
+	BUF->vhl = 0x45;
+	BUF->tos = 0;
+	u16_t total = UIP_IPTCPH_LEN + uip_slen;
+	BUF->len[0] = total >> 8;
+	BUF->len[1] = total & 0xff;
+	BUF->ipid[0] = ++ipid >> 8;
+	BUF->ipid[1] = ipid & 0xff;
+	BUF->ipoffset[0] = 0;
+	BUF->ipoffset[1] = 0;
+	BUF->ttl = 64;
+	BUF->proto = UIP_PROTO_TCP;
+	BUF->srcport = uip_conn->lport;
+	BUF->destport = uip_conn->rport;
+	uip_ipaddr_copy(BUF->srcipaddr, hostaddr);
+	uip_ipaddr_copy(BUF->destipaddr, uip_conn->ripaddr);
+
+	BUF->tcpoffset = (UIP_TCPH_LEN / 4) << 4;
+	BUF->wnd[0] = (UIP_BUFSIZE - UIP_IPTCPH_LEN - UIP_LLH_LEN) >> 8;
+	BUF->wnd[1] = (UIP_BUFSIZE - UIP_IPTCPH_LEN - UIP_LLH_LEN) & 0xff;
+	BUF->urgp[0] = 0;
+	BUF->urgp[1] = 0;
+
+	BUF->ipchksum = 0;
+	BUF->ipchksum = uip_ipchksum();
+	BUF->tcpchksum = 0;
+	uip_len = total;
+	BUF->tcpchksum = uip_tcpchksum();
+
+	uip_arp_out();
+}
