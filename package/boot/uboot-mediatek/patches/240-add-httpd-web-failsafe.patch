+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * Minimal uIP TCP/IP stack definitions for U-Boot HTTPD
+ */
+
+#ifndef __UIP_H__
+#define __UIP_H__
+
+#include <linux/types.h>
+#include <asm/byteorder.h>
+
+typedef u8  u8_t;
+typedef u16 u16_t;
+typedef u32 u32_t;
+
+typedef u16_t uip_ip4addr_t[2];
+typedef u16_t uip_ipaddr_t[2];
+
+#define uip_ipaddr(addr, addr0, addr1, addr2, addr3) do { \
+	((u16_t *)(addr))[0] = htons(((addr0) << 8) | (addr1)); \
+	((u16_t *)(addr))[1] = htons(((addr2) << 8) | (addr3)); \
+} while (0)
+
+#define uip_ipaddr_copy(dest, src) do { \
+	((u16_t *)(dest))[0] = ((u16_t *)(src))[0]; \
+	((u16_t *)(dest))[1] = ((u16_t *)(src))[1]; \
+} while (0)
+
+#define uip_ipaddr_cmp(addr1, addr2) \
+	(((u16_t *)(addr1))[0] == ((u16_t *)(addr2))[0] && \
+	 ((u16_t *)(addr1))[1] == ((u16_t *)(addr2))[1])
+
+struct uip_eth_addr {
+	u8_t addr[6];
+};
+
+struct uip_tcp_conn {
+	uip_ipaddr_t ripaddr;
+	u16_t lport;
+	u16_t rport;
+	u8_t rcv_nxt[4];
+	u8_t snd_nxt[4];
+	u16_t len;
+	u32_t timer;
+	u8_t tcpstateflags;
+	void *appstate;
+};
+
+#define UIP_TCP_CONNS 4
+#define UIP_BUFSIZE   1514
+
+#define UIP_LLH_LEN   14
+#define UIP_IPH_LEN   20
+#define UIP_TCPH_LEN  20
+#define UIP_IPTCPH_LEN (UIP_IPH_LEN + UIP_TCPH_LEN)
+
+extern u8_t uip_buf[UIP_BUFSIZE + 2];
+extern void *uip_appdata;
+extern u16_t uip_len;
+extern u16_t uip_slen;
+extern u8_t uip_flags;
+extern struct uip_tcp_conn *uip_conn;
+extern struct uip_tcp_conn uip_conns[UIP_TCP_CONNS];
+
+/* uIP flags */
+#define UIP_ACKDATA     0x01
+#define UIP_NEWDATA     0x02
+#define UIP_CLOSE       0x04
+#define UIP_ABORT       0x08
+#define UIP_CONNECTED   0x10
+#define UIP_TIMEDOUT    0x20
+#define UIP_POLL        0x40
+
+#define uip_newdata()           (uip_flags & UIP_NEWDATA)
+#define uip_acked()             (uip_flags & UIP_ACKDATA)
+#define uip_connected()         (uip_flags & UIP_CONNECTED)
+#define uip_closed()            (uip_flags & UIP_CLOSE)
+#define uip_aborted()           (uip_flags & UIP_ABORT)
+#define uip_timedout()          (uip_flags & UIP_TIMEDOUT)
+#define uip_poll()              (uip_flags & UIP_POLL)
+#define uip_datalen()           uip_len
+
+#define uip_send(buf, len) do { \
+	uip_appdata = (buf); \
+	uip_slen = (len); \
+} while (0)
+
+#define uip_close() do { \
+	uip_flags |= UIP_CLOSE; \
+} while (0)
+
+#define uip_abort() do { \
+	uip_flags |= UIP_ABORT; \
+} while (0)
+
+/* IP / TCP Headers */
+struct uip_tcpip_hdr {
+	u8_t vhl, tos, len[2], ipid[2], ipoffset[2], ttl, proto;
+	u16_t ipchksum;
+	u16_t srcipaddr[2], destipaddr[2];
+	u16_t srcport, destport;
+	u8_t seqno[4], ackno[4], tcpoffset, flags, wnd[2];
+	u16_t tcpchksum;
+	u8_t urgp[2];
+} __attribute__((packed));
+
+#define UIP_PROTO_ICMP  1
+#define UIP_PROTO_TCP   6
+#define UIP_PROTO_UDP   17
+
+#define TCP_FIN 0x01
+#define TCP_SYN 0x02
+#define TCP_RST 0x04
+#define TCP_PSH 0x08
+#define TCP_ACK 0x10
+#define TCP_URG 0x20
+#define TCP_CTL 0x3f
+
+#define UIP_CLOSED      0
+#define UIP_SYN_RCVD    1
+#define UIP_SYN_SENT    2
+#define UIP_ESTABLISHED 3
+#define UIP_FIN_WAIT_1  4
+#define UIP_FIN_WAIT_2  5
+#define UIP_CLOSING     6
+#define UIP_TIME_WAIT   7
+#define UIP_LAST_ACK    8
+
+void uip_init(void);
+void uip_sethostaddr(uip_ipaddr_t addr);
+void uip_setnetmask(uip_ipaddr_t addr);
+void uip_setdraddr(uip_ipaddr_t addr);
+void uip_setethaddr(struct uip_eth_addr addr);
+void uip_input(void);
+void uip_periodic(int conn);
+void uip_listen(u16_t port);
+void uip_appcall(void);
+
+u16_t uip_chksum(u16_t *buf, u16_t len);
+u16_t uip_ipchksum(void);
+u16_t uip_tcpchksum(void);
+
+#endif
