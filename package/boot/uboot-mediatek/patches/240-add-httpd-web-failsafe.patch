+void uip_appcall(void)
+{
+	char *data = (char *)uip_appdata;
+
+	if (uip_connected()) {
+		tx_ptr = NULL;
+		tx_left = 0;
+		return;
+	}
+
+	if (uip_acked()) {
+		if (tx_left > 0) {
+			send_next_chunk();
+			return;
+		}
+	}
+
+	if (uip_newdata()) {
+		if (strncmp(data, "GET / ", 6) == 0 || strncmp(data, "GET /index.html", 15) == 0 ||
+		    strncmp(data, "GET /favicon.ico", 16) == 0) {
+			if (strncmp(data, "GET /favicon.ico", 16) == 0) {
+				uip_send("HTTP/1.0 404 Not Found\r\nConnection: close\r\n\r\n", 42);
+				uip_close();
+				return;
+			}
+			printf("HTTPD: Delivering recovery web page...\n");
+			static char full_page[4096];
+			int hlen = strlen(resp_200_hdr);
+			int plen = strlen(html_page);
+			if (hlen + plen < sizeof(full_page)) {
+				memcpy(full_page, resp_200_hdr, hlen);
+				memcpy(full_page + hlen, html_page, plen);
+				tx_ptr = full_page;
+				tx_left = hlen + plen;
+				send_next_chunk();
+			} else {
+				uip_close();
+			}
+			return;
+		}
+
+		if (strncmp(data, "POST /upload", 12) == 0) {
+			upload_mode = FW_TYPE_FIRMWARE;
+			if (strstr(data, "type=fip"))
+				upload_mode = FW_TYPE_FIP;
+			else if (strstr(data, "type=initramfs"))
+				upload_mode = FW_TYPE_INITRAMFS;
+			else if (strstr(data, "type=gpt"))
+				upload_mode = FW_TYPE_GPT;
+			else if (strstr(data, "type=bl2"))
+				upload_mode = FW_TYPE_BL2;
+
+			char *sz_str = strstr(data, "size=");
+			expected_size = 0;
+			if (sz_str) {
+				expected_size = simple_strtoul(sz_str + 5, NULL, 10);
+			} else {
+				char *cl = strstr(data, "Content-Length: ");
+				if (cl)
+					expected_size = simple_strtoul(cl + 16, NULL, 10);
+			}
+
+			char *l = env_get("loadaddr");
+			if (l)
+				upload_addr = simple_strtoul(l, NULL, 16);
