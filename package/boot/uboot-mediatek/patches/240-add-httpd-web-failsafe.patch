+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Minimal uIP ARP implementation
+ */
+
+#include <linux/types.h>
+#include <linux/string.h>
+#include <asm/byteorder.h>
+#include <net/uip.h>
+#include <net/uip_arp.h>
+
+#define BUF   ((struct uip_arp_hdr *)&uip_buf[0])
+#define IPBUF ((struct uip_eth_hdr *)&uip_buf[0])
+
+static struct uip_eth_addr default_ethaddr;
+static struct uip_eth_addr client_ethaddr;
+static int client_ethaddr_valid = 0;
+
+void uip_setethaddr(struct uip_eth_addr addr)
+{
+	default_ethaddr = addr;
+}
+
+void uip_set_client_ethaddr(struct uip_eth_addr addr)
+{
+	client_ethaddr = addr;
+	client_ethaddr_valid = 1;
+}
+
+void uip_arp_init(void)
+{
+	client_ethaddr_valid = 0;
+}
+
+void uip_arp_ipin(void)
+{
+	uip_set_client_ethaddr(IPBUF->src);
+}
+
+void uip_arp_arpin(void)
+{
+	if (uip_len < sizeof(struct uip_arp_hdr)) {
+		uip_len = 0;
+		return;
+	}
+
+	if (BUF->opcode == htons(ARP_REQUEST)) {
+		uip_set_client_ethaddr(BUF->shwaddr);
+
+		BUF->opcode = htons(ARP_REPLY);
+
+		memcpy(BUF->dhwaddr.addr, BUF->shwaddr.addr, 6);
+		memcpy(BUF->shwaddr.addr, default_ethaddr.addr, 6);
+		memcpy(BUF->ethhdr.dest.addr, BUF->dhwaddr.addr, 6);
+		memcpy(BUF->ethhdr.src.addr, default_ethaddr.addr, 6);
+
+		BUF->dipaddr[0] = BUF->sipaddr[0];
+		BUF->dipaddr[1] = BUF->sipaddr[1];
+
+		extern uip_ipaddr_t hostaddr;
+		BUF->sipaddr[0] = ((u16_t *)hostaddr)[0];
+		BUF->sipaddr[1] = ((u16_t *)hostaddr)[1];
+
+		BUF->ethhdr.type = htons(UIP_ETHTYPE_ARP);
+		uip_len = sizeof(struct uip_arp_hdr);
+		return;
+	}
+
+	uip_len = 0;
+}
+
+void uip_arp_out(void)
+{
+	if (!client_ethaddr_valid) {
+		uip_len = 0;
+		return;
+	}
+
+	memcpy(IPBUF->dest.addr, client_ethaddr.addr, 6);
+	memcpy(IPBUF->src.addr, default_ethaddr.addr, 6);
+	IPBUF->type = htons(UIP_ETHTYPE_IP);
+	uip_len += UIP_LLH_LEN;
+}
