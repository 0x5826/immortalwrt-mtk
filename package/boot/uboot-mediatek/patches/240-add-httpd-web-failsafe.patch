+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2026 Dante <dante@seckv.com>
+ * Web Failsafe Command for BPi-R4 and MediaTek Platforms
+ */
+
+#include <command.h>
+#include <env.h>
+#include <net.h>
+#include <stdio.h>
+#include <net/httpd.h>
+
+static int do_httpd(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	char *ip;
+
+	ip = env_get("ipaddr");
+	if (!ip) {
+		env_set("ipaddr", "192.168.1.1");
+		ip = "192.168.1.1";
+	}
+
+	printf("\n=======================================================\n");
+	printf("  Banana Pi BPi-R4 Web Failsafe HTTP Recovery Server\n");
+	printf("  Web UI Address: http://%s/\n", ip);
+	printf("  Please connect PC to LAN port and configure static IP:\n");
+	printf("    IP: 192.168.1.2  /  Subnet: 255.255.255.0\n");
+	printf("  Press Ctrl+C to abort and return to console.\n");
+	printf("=======================================================\n\n");
+
+	if (net_loop(HTTPD) < 0) {
+		printf("HTTPD: Network loop terminated or failed.\n");
+		return CMD_RET_FAILURE;
+	}
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	httpd, 1, 1, do_httpd,
+	"Start Web Failsafe HTTP recovery server",
+	"\n    - Starts mini HTTP server on port 80 to flash firmware via web browser\n"
+);
