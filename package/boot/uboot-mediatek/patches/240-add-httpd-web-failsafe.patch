+void httpd_start(void)
+{
+	struct uip_eth_addr eaddr;
+	uip_ipaddr_t ip;
+	uchar *net_mac = net_ethaddr;
+
+	memcpy(eaddr.addr, net_mac, 6);
+
+	char *ip_str = env_get("ipaddr");
+	if (!ip_str)
+		ip_str = "192.168.1.1";
+
+	struct in_addr in;
+	in = string_to_ip(ip_str);
+	u32 nip = ntohl(in.s_addr);
+
+	uip_init();
+	uip_arp_init();
+
+	uip_setethaddr(eaddr);
+	uip_ipaddr(ip, (nip >> 24) & 0xff, (nip >> 16) & 0xff, (nip >> 8) & 0xff, nip & 0xff);
+	uip_sethostaddr(ip);
+
+	uip_listen(80);
+	httpd_active = 1;
+	in_upload = 0;
+	upload_finished = 0;
+
+	printf("HTTPD: Web Failsafe daemon initialized and listening on port 80.\n");
+}
