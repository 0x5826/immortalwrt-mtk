+static int httpd_active = 0;
+static ulong upload_addr = 0x50000000;
+static size_t upload_size = 0;
+static size_t expected_size = 0;
+static int in_upload = 0;
+static int upload_finished = 0;
+
+/* Ultra-compact, single MSS (< 1420 bytes) modern HTML page */
+static const char html_page[] =
+"<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>BPi-R4 Failsafe</title>"
+"<style>body{font-family:sans-serif;background:#181818;color:#eee;margin:10% auto;width:300px}"
+"h3{color:#58a6ff}input,button{width:100%;margin:6px 0;padding:8px;box-sizing:border-box}"
+"button{background:#28a745;color:#fff;border:0;border-radius:4px;cursor:pointer}"
+"#p{height:6px;background:#333;display:none}#pb{height:100%;width:0;background:#58a6ff}"
+"#m{font-size:12px;color:#58a6ff}</style></head><body>"
+"<h3>BPi-R4 Failsafe</h3><p style=\"font-size:12px;color:#888\">MT7988A (192.168.1.1)</p>"
+"<input type=\"file\" id=\"f\"><div id=\"p\"><div id=\"pb\"></div></div>"
+"<button id=\"b\" onclick=\"up()\">Flash Firmware</button><div id=\"m\"></div>"
+"<script>function up(){var f=document.getElementById('f').files[0];if(!f)return;"
+"document.getElementById('b').disabled=true;document.getElementById('p').style.display='block';"
+"var x=new XMLHttpRequest();x.open('POST','/upload?size='+f.size,true);"
+"x.upload.onprogress=function(e){var p=Math.round(e.loaded/e.total*100);"
+"document.getElementById('pb').style.width=p+'%';document.getElementById('m').innerText='Uploading: '+p+'%';};"
+"x.onload=function(){document.getElementById('m').innerText='Flashing! Rebooting...';};"
+"x.onerror=function(){document.getElementById('m').innerText='Failed!';document.getElementById('b').disabled=false;};"
+"x.send(f);}</script></body></html>";
+
+static const char resp_200_hdr[] =
+"HTTP/1.0 200 OK\r\n"
+"Content-Type: text/html\r\n"
+"Connection: close\r\n\r\n";
+
+static const char resp_ok_hdr[] =
+"HTTP/1.0 200 OK\r\n"
+"Content-Type: text/plain\r\n"
+"Connection: close\r\n\r\n"
+"Upload complete. Flashing firmware...";
+
+void uip_appcall(void)
+{
+	char *data = (char *)uip_appdata;
+
+	if (uip_connected()) {
+		return;
+	}
+
+	if (uip_newdata()) {
+		if (strncmp(data, "GET / ", 6) == 0 || strncmp(data, "GET /index.html", 15) == 0) {
+			static char buf[1500];
+			int hlen = strlen(resp_200_hdr);
+			int plen = strlen(html_page);
+			if (hlen + plen < sizeof(buf)) {
+				memcpy(buf, resp_200_hdr, hlen);
+				memcpy(buf + hlen, html_page, plen);
+				uip_send(buf, hlen + plen);
+			}
+			uip_close();
+			return;
+		}
+
+		if (strncmp(data, "POST /upload", 12) == 0) {
+			char *sz_str = strstr(data, "size=");
+			expected_size = 0;
+			if (sz_str) {
+				expected_size = simple_strtoul(sz_str + 5, NULL, 10);
+			} else {
+				char *cl = strstr(data, "Content-Length: ");
+				if (cl)
+					expected_size = simple_strtoul(cl + 16, NULL, 10);
+			}
+
+			char *l = env_get("loadaddr");
+			if (l)
+				upload_addr = simple_strtoul(l, NULL, 16);
+
+			printf("\nHTTPD: Starting firmware upload to 0x%08lx (expected %zu bytes)...\n",
+			       upload_addr, expected_size);
+
+			in_upload = 1;
+			upload_size = 0;
+
+			char *body = strstr(data, "\r\n\r\n");
+			if (body) {
+				body += 4;
+				int chunk = uip_datalen() - (body - data);
+				if (chunk > 0) {
+					memcpy((void *)upload_addr, body, chunk);
+					upload_size = chunk;
+				}
+			}
+			return;
+		}
+
+		if (in_upload) {
+			int chunk = uip_datalen();
+			if (upload_size + chunk <= HTTPD_MAX_DATA_SIZE) {
+				memcpy((void *)(upload_addr + upload_size), data, chunk);
+				upload_size += chunk;
+				if ((upload_size % (1024 * 512)) < chunk)
+					printf("#");
+			}
+
+			if (expected_size > 0 && upload_size >= expected_size) {
+				printf("\nHTTPD: Received all %zu bytes.\n", upload_size);
+				uip_send((void *)resp_ok_hdr, strlen(resp_ok_hdr));
+				uip_close();
+				in_upload = 0;
+				upload_finished = 1;
+			}
+			return;
+		}
+
+		uip_send("HTTP/1.0 404 Not Found\r\nConnection: close\r\n\r\n", 42);
+		uip_close();
+	}
+}
+
+int httpd_is_active(void)
+{
+	return httpd_active;
+}
+
+void httpd_start(void)
+{
+	struct uip_eth_addr eaddr;
+	uip_ipaddr_t ip;
+	uchar *net_mac = net_ethaddr;
+
+	memcpy(eaddr.addr, net_mac, 6);
+
+	char *ip_str = env_get("ipaddr");
+	if (!ip_str)
+		ip_str = "192.168.1.1";
+
+	struct in_addr in;
+	in = string_to_ip(ip_str);
+	u32 nip = ntohl(in.s_addr);
+
+	uip_init();
+	uip_arp_init();
+
+	uip_setethaddr(eaddr);
+	uip_ipaddr(ip, (nip >> 24) & 0xff, (nip >> 16) & 0xff, (nip >> 8) & 0xff, nip & 0xff);
+	uip_sethostaddr(ip);
+
+	uip_listen(80);
+	httpd_active = 1;
+	in_upload = 0;
+	upload_finished = 0;
+
+	printf("HTTPD: Web Failsafe daemon initialized and listening on port 80.\n");
+}
+
+void httpd_poll(void)
+{
+	if (upload_finished) {
+		upload_finished = 0;
+		printf("HTTPD: Verifying and flashing firmware...\n");
+
+		char sz_buf[32];
+		snprintf(sz_buf, sizeof(sz_buf), "0x%zx", upload_size);
+		env_set("filesize", sz_buf);
+
+		int ret = run_command("run web_failsafe_flash", 0);
+		if (ret == 0) {
+			printf("HTTPD: Flash succeeded! Rebooting into new system...\n");
+			mdelay(2000);
+			do_reset(NULL, 0, 0, NULL);
+		} else {
+			printf("HTTPD: Flash failed or rejected! (code %d)\n", ret);
+		}
+	}
+}
+
+void httpd_rx(uchar *pkt, int len)
+{
+	struct uip_eth_hdr *eth = (struct uip_eth_hdr *)pkt;
+	u16_t type = ntohs(eth->type);
+
+	if (len > UIP_BUFSIZE)
+		len = UIP_BUFSIZE;
+
+	memcpy(uip_buf, pkt, len);
+	uip_len = len;
+
+	if (type == UIP_ETHTYPE_ARP) {
+		uip_arp_arpin();
+		if (uip_len > 0) {
+			net_send_packet(uip_buf, uip_len);
+		}
+	} else if (type == UIP_ETHTYPE_IP) {
+		uip_arp_ipin();
+		uip_input();
+		if (uip_len > 0) {
+			net_send_packet(uip_buf, uip_len);
+		}
+	}
+}
+
+void httpd_stop(void)
+{
+	httpd_active = 0;
+}
